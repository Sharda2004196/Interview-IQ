# Backend image: Python 3.12 slim + deps + code. No secrets baked in —
# keys arrive at runtime via compose env_file (same .env you already use).
FROM python:3.12-slim

WORKDIR /app

COPY interviewiq_agent/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY interviewiq_agent/ ./interviewiq_agent/
COPY backend/ ./backend/

# Same OTel kill-switch as compose: covers Render/prod where no env_file exists.
ENV OTEL_SDK_DISABLED=true
# Same grpc IPv4 preference as compose: containers often lack an IPv6 route.
ENV GRPC_DNS_RESOLVER=native

EXPOSE 8000

# Cloud Run injects $PORT (default 8000 keeps `docker compose up` working).
CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
